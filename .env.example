# Copy to .env and fill in. .env is gitignored and must never be committed.

# Port the server listens on. Defaults to 8080 if unset or invalid.
PORT=8080

# "local" or "production".
APP_ENV=local

# Discord bot used by the contact form. The bot needs permission to post in
# DISCORD_CHANNEL_ID. If either value is unset the contact form returns an
# error to the visitor -- it does not stop the server.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
