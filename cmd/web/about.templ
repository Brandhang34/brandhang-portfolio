package web

templ About() {
	@Base() {
		@PageHeader("About Me")
		<div class="container mx-auto">
			<div class="block sm:flex sm:gap-10 mt-2 sm:mt-4">
				<div class="font-primary max-w-screen-lg md:w-2xl text-left">
					<h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white">Hi, I'm Brandon</h2>
					<p class="text-neutral-200 text-sm sm:text-md md:text-lg">
						Client Platform Engineer
					</p>
					@Socials()
					<p class="mb-4 text-neutral-200 text-md sm:text-md md:text-lg">
						A passionate Platform engineer, Solutions architect and Sys Admin. IT graduate from California State University, Fresno. Currently working at Meta as a Platform Engineer.
					</p>
					<p class="mb-4 text-neutral-200 text-md sm:text-md md:text-lg">
						Have experience with cloud computing (AWS), Docker containers, Infrastructure as code, CICD pipelines and github actions. Also have knowledge on networking, creating web apps, and automation scripting.
					</p>
					<p class="mb-4 text-neutral-200 text-md md:text-lg">
						I enjoy building new relationships and finding more efficient solutions to ongoing problems. On my free time, I play tennis, video games, tinker with my home server, and have recently picked up 3d printing and photography.
					</p>
				</div>
				<div class="flex flex-col items-center w-full sm:w-1/4 mb-7 sm:mb-0">
					<img class="rounded-lg w-96 hidden md:flex md:w-auto" src="/assets/imgs/avataaars.svg" alt="Illustrated avatar of Brandon Hang"/>
					<a href="https://resume.brandhang.net" class="font-primary mt-4 px-6 py-2.5 md:flex text-md w-full text-white inline-flex bg-blue-500 hover:bg-blue-600 focus:ring-4 focus:outline-none focus:ring-blue-300 rounded-lg justify-center">
						<img class="h-6 w-6 text-white me-2 max-w-screen-lg" src="/assets/imgs/resume.svg" alt=""/>
						Resume
					</a>
				</div>
			</div>
		</div>
	}
}

templ Socials() {
	<ul class="text-blue-400 container flex gap-5 list-none">
		@SocialLink("https://www.linkedin.com/in/brandon-hang-a8a2b220b/", "fa-brands fa-linkedin", "LinkedIn")
		@SocialLink("https://github.com/Brandhang34", "fa-brands fa-github", "GitHub")
		@SocialLink("https://www.facebook.com/BrandonHang34", "fa-brands fa-facebook", "Facebook")
		@SocialLink("https://www.instagram.com/brandang34", "fa-brands fa-instagram", "Instagram")
		@SocialLink("https://twitter.com/Brandhang34", "fa-brands fa-x-twitter", "X")
		@SocialLink("https://littlelink.sushamae.com", "fa-solid fa-fw fa-link", "All my links")
	</ul>
}

// SocialLink renders an icon-only link. The visually hidden label gives the link
// an accessible name -- without it screen readers announce six unnamed links.
templ SocialLink(href, icon, label string) {
	<li>
		<a href={ templ.SafeURL(href) } target="_blank" rel="noopener noreferrer">
			<i class={ icon } aria-hidden="true"></i>
			<span class="sr-only">{ label }</span>
		</a>
	</li>
}
