package web

templ Contact() {
	@Base() {
		@PageHeader("Contact")
		<div class="px-4 mx-auto max-w-screen-md">
			<form
				class="space-y-8"
				hx-post="/submit-contact-msg"
				hx-target="#contact-result"
				hx-disabled-elt="find button[type=submit]"
			>
				<div>
					<label for="email" class="font-primary block mb-2 text-sm font-medium text-gray-300">Email</label>
					<input type="email" name="email" id="email" autocomplete="email" class={ contactFieldClass } required/>
				</div>
				<div>
					<label for="subject" class="font-primary block mb-2 text-sm font-medium text-gray-300">Subject</label>
					<input type="text" name="subject" id="subject" maxlength="200" class={ contactFieldClass } required/>
				</div>
				<div class="sm:col-span-2">
					<label for="message" class="font-primary block mb-2 text-sm font-medium text-gray-300">Message</label>
					<textarea id="message" name="message" rows="6" maxlength="4000" class={ contactFieldClass } required></textarea>
				</div>
				// Honeypot: hidden from users, tempting to bots. Real submissions
				// leave it empty.
				<div class="hidden" aria-hidden="true">
					<label for="website">Leave this field empty</label>
					<input type="text" name="website" id="website" tabindex="-1" autocomplete="off"/>
				</div>
				<button type="submit" class="font-primary px-5 py-2.5 text-sm font-medium text-white inline-flex items-center bg-blue-500 hover:bg-blue-600 focus:ring-4 focus:outline-none focus:ring-blue-300 rounded-lg text-center disabled:opacity-60">
					<svg class="w-3.5 h-3.5 text-white me-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 16">
						<path d="m10.036 8.278 9.258-7.79A1.979 1.979 0 0 0 18 0H2A1.987 1.987 0 0 0 .641.541l9.395 7.737Z"></path>
						<path d="M11.241 9.817c-.36.275-.801.425-1.255.427-.428 0-.845-.138-1.187-.395L0 2.6V14a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V2.5l-8.759 7.317Z"></path>
					</svg>
					Send Message
				</button>
			</form>
			// The submit response targets this element. It used to target the
			// button itself, so a successful send blanked out the button label.
			<div id="contact-result" class="mt-6" role="status" aria-live="polite"></div>
		</div>
	}
}

// ContactResult is the fragment swapped in after a contact-form submission.
templ ContactResult(ok bool, message string) {
	if ok {
		<p class="font-primary rounded-lg bg-green-900 px-4 py-3 text-green-100">
			Thanks -- your message is on its way. I'll get back to you soon.
		</p>
	} else {
		<p class="font-primary rounded-lg bg-red-900 px-4 py-3 text-red-100">{ message }</p>
	}
}
