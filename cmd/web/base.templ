package web

templ Base() {
	<!DOCTYPE html>
	<html lang="en" class="h-screen">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Brandon Hang - Portfolio</title>
			<link href="/assets/css/output.css" rel="stylesheet"/>
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
			<script src="/assets/js/htmx.min.js"></script>
		</head>
		<body class="bg-slate-800">
			<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-blue-600 focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
			@Nav()
			<main id="main" class="max-w-screen-lg mx-auto p-4">
				{ children... }
			</main>
		</body>
	</html>
}
